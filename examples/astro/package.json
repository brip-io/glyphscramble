{
  "name": "@brip/glyphscramble-example-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:glyphs": "node ../../packages/core/dist/cli.js prepare --config glyphscramble.config.ts",
    "check": "astro check",
    "build:ssr": "astro build",
    "build:static": "astro build --config astro.static.config.ts && node ../../packages/core/dist/cli.js static --config glyphscramble.config.ts --input dist-static-input --output dist-static",
    "start": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.5",
    "@brip/glyphscramble": "workspace:*",
    "@brip/glyphscramble-astro": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.1",
    "typescript": "^5.9.2"
  }
}
