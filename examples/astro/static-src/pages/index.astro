---
import GlyphStaticBoundary from "@brip/glyphscramble-astro/GlyphStaticBoundary.astro";
import ResearchCard from "../components/ResearchCard.astro";
---

<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>Static Astro example</title></head>
  <body>
    <h1>Indexable static Astro heading</h1>
    <p>Indexable summary and acquisition context stay outside the boundary.</p>
    <GlyphStaticBoundary font="body" as="article" class="research-card">
      <ResearchCard />
    </GlyphStaticBoundary>
  </body>
</html>
