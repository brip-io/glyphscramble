{
  "name": "@brip/glyphscramble-sveltekit",
  "version": "0.1.0-beta.0",
  "description": "SvelteKit handle and endpoint integration for GlyphScramble.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@brip/glyphscramble": "workspace:^",
    "@brip/glyphscramble-svelte": "workspace:^"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2 <3",
    "svelte": ">=5 <6"
  }
}
