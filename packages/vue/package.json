    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@brip/glyphscramble": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.5 <4"
  },
  "devDependencies": {
    "vue": "^3.5.21"
  }
