{
  "name": "@brip/glyphscramble-vue",
  "version": "0.1.0-beta.0",
  "description": "Vue component for GlyphScramble payloads.",
  "keywords": [
    "anti-scraping",
    "font",
    "unicode",
    "vue",
    "woff2"
  ],
  "author": "BRIP Engineering <eng@brip.io> (https://brip.io)",
  "homepage": "https://github.com/brip-io/glyphscramble#readme",
  "bugs": {
    "url": "https://github.com/brip-io/glyphscramble/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brip-io/glyphscramble.git",
    "directory": "packages/vue"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
