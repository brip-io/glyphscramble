{
  "name": "@brip/glyphscramble-astro",
  "version": "0.1.0-beta.0",
  "description": "Astro SSR integration for GlyphScramble.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./GlyphScramble.astro": "./src/GlyphScramble.astro"
  },
  "files": [
    "dist",
    "src/GlyphScramble.astro"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@brip/glyphscramble": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=7 <8"
  }
}
