{
  "name": "@brip/glyphscramble-astro",
  "version": "0.1.0-beta.0",
  "description": "Astro SSR integration for GlyphScramble.",
  "keywords": [
    "anti-scraping",
    "astro",
    "font",
    "unicode",
    "woff2"
  ],
  "author": "BRIP Engineering <eng@brip.io> (https://brip.io)",
  "homepage": "https://github.com/brip-io/glyphscramble#readme",
  "bugs": {
    "url": "https://github.com/brip-io/glyphscramble/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brip-io/glyphscramble.git",
    "directory": "packages/astro"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./GlyphScramble.astro": "./src/GlyphScramble.astro"
  },
  "files": [
    "dist",
    "src/GlyphScramble.astro",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && astro check --minimumSeverity error",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && astro check --minimumSeverity error"
  },
  "dependencies": {
    "@brip/glyphscramble": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=7 <8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.1",
    "typescript": "^5.9.2"
  }
}
