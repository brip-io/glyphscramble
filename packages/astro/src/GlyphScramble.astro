---
import type { GlyphPayload } from "@brip/glyphscramble";
const { payload } = Astro.props as { payload: GlyphPayload };
---

<span
  hidden
  aria-hidden="true"
  lang={payload.lang}
  data-glyphscramble-mount
  data-glyphscramble-payload={JSON.stringify(payload)}
>{payload.encodedText}</span>
<script>
  import {
    mountGlyphPayload,
    type GlyphMountHandle,
  } from "@brip/glyphscramble/runtime";

  const handles = new Map<HTMLElement, GlyphMountHandle>();
  function mountAll() {
    for (const node of document.querySelectorAll<HTMLElement>(
      "[data-glyphscramble-mount]",
    )) {
      if (handles.has(node)) continue;
      const serialized = node.dataset.glyphscramblePayload;
      if (!serialized) continue;
      handles.set(node, mountGlyphPayload(node, JSON.parse(serialized)));
    }
  }

  document.addEventListener("astro:before-swap", () => {
    for (const handle of handles.values()) handle.destroy();
    handles.clear();
  });
  document.addEventListener("astro:page-load", mountAll);
  mountAll();
</script>
