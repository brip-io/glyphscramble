---
import type { GlyphPayload } from "@brip/glyphscramble";

export interface Props {
  payload: GlyphPayload;
  fontTimeoutMs?: number;
  errorText?: string;
}

const { payload, fontTimeoutMs, errorText } = Astro.props;
---

<brip-glyphscramble-v3
  data-payload={JSON.stringify(payload)}
  data-timeout={fontTimeoutMs}
  data-error={errorText}
>
  <span hidden aria-hidden="true" lang={payload.lang} data-content
    >{payload.encodedText}</span
  >
</brip-glyphscramble-v3>

<style>
  brip-glyphscramble-v3 {
    display: contents;
  }
</style>

<script>
  import {
    mountGlyphPayload,
    type GlyphMountHandle,
  } from "@brip/glyphscramble/runtime";

  const ELEMENT = "brip-glyphscramble-v3";

  class GlyphScrambleElement extends HTMLElement {
    #mount: GlyphMountHandle | undefined;

    connectedCallback() {
      if (this.#mount) return;
      const element = this.querySelector<HTMLElement>(":scope > [data-content]");
      const serialized = this.dataset.payload;
      if (!element || !serialized) return;
      try {
        const timeout = this.dataset.timeout;
        this.#mount = mountGlyphPayload(element, JSON.parse(serialized), {
          ...(timeout ? { timeoutMs: Number(timeout) } : {}),
          ...(this.dataset.error === undefined
            ? {}
            : { errorText: this.dataset.error }),
        });
      } catch {
        element.textContent =
          this.dataset.error ??
          "This protected content could not be displayed.";
        element.dataset.glyphscramble = "error";
        element.hidden = false;
      }
    }

    disconnectedCallback() {
      this.#mount?.destroy();
      this.#mount = undefined;
    }
  }

  if (!customElements.get(ELEMENT))
    customElements.define(ELEMENT, GlyphScrambleElement);
</script>
