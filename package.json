{
  "name": "glyphscramble",
  "version": "0.0.0",
  "private": true,
  "description": "Raise the cost of bulk DOM scraping with per-response glyph scrambling.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "benchmark:runtime": "pnpm build && node scripts/benchmark-runtime.mjs",
    "prototype:woff1": "pnpm --filter @brip/glyphscramble build && node scripts/woff1-prototype.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:package-version && pnpm test:package-quality && pnpm test:distribution",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:unicode": "node scripts/generate-unicode.mjs",
    "generate:version": "pnpm --filter @brip/glyphscramble generate:version",
    "check:unicode": "node scripts/generate-unicode.mjs --check",
    "qualify:font": "pnpm --filter @brip/glyphscramble build && node scripts/qualify-font.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:package-version": "node scripts/verify-package-version.mjs",
    "test:package-quality": "node scripts/verify-package-quality.mjs",
    "test:distribution": "node scripts/prepare-release-artifacts.mjs",
    "test:e2e": "playwright test",
    "test:next": "playwright test --config playwright.next.config.ts",
    "test:nuxt": "playwright test --config playwright.nuxt.config.ts",
    "test:sveltekit": "playwright test --config playwright.sveltekit.config.ts",
    "test:r10": "pnpm build:r10-fixtures && playwright test --config playwright.r10.config.ts",
    "build:r10-fixtures": "pnpm --filter @brip/glyphscramble build && pnpm --filter @brip/glyphscramble-astro build && pnpm --filter @brip/glyphscramble-vite build && pnpm --dir examples/astro prepare:glyphs && pnpm --dir examples/astro check && pnpm --dir examples/astro build:ssr && pnpm --dir examples/astro build:static && pnpm --dir examples/vite-static prepare:glyphs && pnpm --dir examples/vite-static build:fixture && pnpm --dir examples/vite-static qualify:rebuild && pnpm --dir examples/node-fetch prepare:glyphs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm generate:version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.3",
    "@unicode/unicode-17.0.0": "^1.6.17",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.24",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
